		annotation SummarizationSetBy = Automatic

	column valor_produto
		dataType: double
		formatString: \R\$ #,0.00;(\R\$ #,0.00);\R\$ #,0.00
		lineageTag: b74bff25-99fd-40ff-bfad-06c0b6724398
		summarizeBy: sum
		sourceColumn: valor_produto

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column valor_frete
		dataType: double
		lineageTag: 4a13f316-9915-4fc5-a4e7-86b2aeef54a5
		summarizeBy: sum
		sourceColumn: valor_frete

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column valor_total_com_frete
		dataType: double
		formatString: \R\$ #,0.00;(\R\$ #,0.00);\R\$ #,0.00
		lineageTag: 2fa7975c-5919-48fa-b297-4215acf5d5f7
		summarizeBy: sum
		sourceColumn: valor_total_com_frete

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Primeiro dia do mês da compra, para ordenar a evolução mensal cronologicamente.
	column 'Mês da Compra' = IF(ISBLANK([order_purchase_timestamp]), BLANK(), DATE(YEAR([order_purchase_timestamp]), MONTH([order_purchase_timestamp]), 1))
		dataType: dateTime
		formatString: MMM yyyy
		lineageTag: dc36c596-6c64-4b75-a567-4a97aff318e9
		summarizeBy: none

