table gold_olist_vendas_consolidadas
	lineageTag: ebd5c023-3a72-4469-84c1-fe6398c16eb2

	measure 'Faturamento Total' = SUM('gold_olist_vendas_consolidadas'[valor_produto])
		formatString: \R\$ #,0.00
		displayFolder: Indicadores

	measure 'Volume de Pedidos' = DISTINCTCOUNT('gold_olist_vendas_consolidadas'[order_id])
		formatString: #,0
		displayFolder: Indicadores

	measure 'Valor Total com Frete' = SUM('gold_olist_vendas_consolidadas'[valor_total_com_frete])
		formatString: \R\$ #,0.00
		displayFolder: Indicadores

	measure 'Tempo Médio de Entrega' = AVERAGE('gold_olist_vendas_consolidadas'[dias_para_entrega])
		formatString: 0.0
		displayFolder: Indicadores

	column order_id
		dataType: string
		lineageTag: edd45c93-67f4-4170-bb5a-55daed8935ba
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

