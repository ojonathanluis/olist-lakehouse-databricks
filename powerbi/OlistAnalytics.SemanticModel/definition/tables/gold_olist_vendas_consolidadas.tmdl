		sourceColumn: order_status

		annotation SummarizationSetBy = Automatic

	column order_purchase_timestamp
		dataType: dateTime
		formatString: General Date
		lineageTag: e13b5ede-eb49-4ff5-9cff-b6f7a1775698
		summarizeBy: none
		sourceColumn: order_purchase_timestamp

		variation Variation
			isDefault
			relationship: 2cb85616-4d9b-428e-b7a2-787405900555
			defaultHierarchy: LocalDateTable_df4a51bd-9b77-4713-b1c9-d4ad3bfff667.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column order_delivered_customer_date
		dataType: dateTime
		formatString: General Date
		lineageTag: 11dd74ef-f9c0-4bce-80e1-13dbc702ceab
		summarizeBy: none
		sourceColumn: order_delivered_customer_date

		variation Variation
			isDefault
			relationship: a482aa0a-a7a1-4e1c-b3f6-0d33c909c072
			defaultHierarchy: LocalDateTable_78cf344c-830c-4bbc-bc22-1515df805afe.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column order_estimated_delivery_date
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: order_estimated_delivery_date

	column dias_para_entrega
		dataType: int64
		formatString: 0.00
		lineageTag: 22df0bff-fa99-46be-b376-bc63529bc3df
		summarizeBy: average
		sourceColumn: dias_para_entrega

